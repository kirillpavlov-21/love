{
  "name": "kuda-server",
  "version": "1.0.0",
  "private": true,
  "description": "Бэкенд «Куда идём?»: голоса компании, ответы на приглашения, отзывы и рейтинги, короткие ссылки",
  "engines": {
    "node": ">=22.5"
